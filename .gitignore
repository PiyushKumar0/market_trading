# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# --- Runtime data + state (NEVER committed) ---
data/
!data/.gitkeep

# Crash leftovers of the protected-config writers (ProtectedStore, protected_config_status --restore).
config/.*.tmp

# --- Secrets (R10: secrets live in Windows Credential Manager / DPAPI, never on disk) ---
.env
*.env
!.env.example
*.token
*.key
*.pem
secrets.*
# ...but not the keyring-access module (code, no secret values): ignoring it left a fresh clone
# unable to import `engine` (found 2026-09-23 building a scratch worktree).
!src/engine/core/secrets.py

# --- Dashboard build output ---
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/

# web/dist/ is SOURCE, not build output: the hand-written, dependency-free notifications page
# (served at /notifications-ui). The generic `dist/` rule above would otherwise swallow it,
# so the only file the platform's own dashboard page consists of could never be committed.
!web/dist/

# --- OS / editor ---
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code harness transient state (keep .claude/settings*.json if you add them) ---
.claude/scheduled_tasks.lock
.claude/projects/
.claude/worktrees/
.claude/settings.local.json

# --- graphify knowledge-graph output (owner tool, regenerated on demand) ---
graphify-out/

# uv lockfile IS committed (reproducible builds) — do not ignore uv.lock

node_modules/