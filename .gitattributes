# Protected config: the ProtectedStore registers the SHA-256 of the LF bytes it writes
# (protected_store.owner_update rewrites CRLF -> LF). Pin LF here so a future checkout on a
# core.autocrlf=true box cannot re-materialize CRLF and re-trigger a hash mismatch / FROZEN boot.
config/*.yaml text eol=lf
config/calendar/*.yaml text eol=lf
runbooks/patches/*.patch text eol=lf
# The macro mood study's frozen inputs: the nightly scorer pins the mapper prompt's bytes by SHA-256, so a CRLF
# checkout would stop its scoring.
config/research/macro_mood/* text eol=lf
